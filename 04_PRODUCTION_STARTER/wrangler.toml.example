name = "genevieve-family-budget-cookbook"
main = "src/index.ts"
compatibility_date = "2026-09-05"
compatibility_flags = ["nodejs_compat"]

[assets]
directory = "./public"
binding = "ASSETS"

[[hyperdrive]]
binding = "HYPERDRIVE"
id = "REPLACE_WITH_CLOUDFLARE_HYPERDRIVE_ID"

# Local development:
# use a gitignored .dev.vars file with
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
# rather than putting a database connection string in this file.
# See .dev.vars.example.

# Secrets belong in Cloudflare secrets, never this file:
# wrangler secret put STRIPE_SECRET_KEY
# wrangler secret put STRIPE_WEBHOOK_SECRET
